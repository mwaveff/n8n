    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst seen = new Set();\nconst KEYWORDS = ['business','enterprise','roi','automation','retail','llm','agent','vision','detection','deploy','production','case study','customer','cost','revenue'];\nlet out = [];\nfor (const it of items) {\n  const j = it.json;\n  const link = j.link || j.guid;\n  if (!link || seen.has(link)) continue;\n  seen.add(link);\n  const d = new Date(j.pubDate || j.isoDate || 0).getTime();\n  if (!d || now - d > 1000 * 60 * 60 * 24 * 7) continue;\n  const txt = ((j.title || '') + ' ' + (j.contentSnippet || j.content || '')).toLowerCase();\n  const score = KEYWORDS.reduce((s, k) => s + (txt.includes(k) ? 1 : 0), 0);\n  out.push({ json: { title: j.title, link, snippet: (j.contentSnippet || j.content || '').slice(0, 400), score } });\n}\nout.sort((a, b) => b.json.score - a.json.score);\nconst top = out.slice(0, 8);\nconst list = top.map((t, i) => `${i + 1}. ${t.json.title}\\n${t.json.snippet}\\nДжерело: ${t.json.link}`).join('\\n\\n');\nreturn [{ json: { list, count: top.length } }];"
      },
